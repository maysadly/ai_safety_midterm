# Copy to .env and fill in. .env is in .gitignore and must never be committed.
# Generate random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# Password for /admin and /demo (8+ characters).
ADMIN_PASSWORD=
# Key that signs the admin login cookie (16+ characters, random).
COOKIE_SECRET=
# Salt for hashing client IPs in the logs (random). Logs never contain raw IPs.
IP_HASH_SALT=

OLLAMA_URL=http://127.0.0.1:11434

# Rate limit for /api/chat per client IP. Set RATE_LIMIT_ENABLED=false for experiment runs.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10

# Start value of the "debug lines" switch in /admin (blocked_by, guard verdict, latency under answers).
DEBUG_LINES=false

# Where the JSONL logs go (relative to the repository root).
CHAT_LOG_PATH=logs/chat.jsonl
EVAL_LOG_PATH=logs/evaluations.jsonl
